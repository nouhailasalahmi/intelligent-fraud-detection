# ============================================
# Configuration Base de données PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transactions_db
DB_USER=user
DB_PASSWORD=userpassword

# ============================================
# Configuration Kafka
# ============================================
KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TOPIC=transactions
KAFKA_AUTO_OFFSET_RESET=latest

# ============================================
# Configuration LLM & Agent
# ============================================
# Provider : "ollama", "openai", "mistral", "anthropic"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Clés API (si provider autre qu'ollama)
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Mode Agent IA (True pour FraudAgent avec outils, False pour FraudAnalyzer)
USE_AGENT=True

# ============================================
# Simulation / Données
# ============================================
N_CUSTOMERS=1000
N_TRANSACTIONS=100000
N_HISTORY=50
IS_FRAUD_RATIO=0.05
